# Copy to .env and fill in. Never commit .env.

# openai | mlx  (omlx is an alias for mlx). CLI --provider wins.
LLM_PROVIDER=mlx

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Local oMLX (OpenAI-compatible). OMLX_* aliases work.
# Dashboard or root URLs are rewritten to /v1.
MLX_API_KEY=
MLX_BASE_URL=http://127.0.0.1:8000/v1
MLX_MODEL=default

# Shared fallback if OPENAI_MODEL / MLX_MODEL is unset
# LLM_MODEL=gpt-4o

# Timeouts (seconds) and retries. MLX default timeout is 300; OpenAI 120.
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=5
# OPENAI_TIMEOUT=120
# MLX_TIMEOUT=300

# Prometheus in model.py. 0 disables. Do not bind 8000 (usual oMLX port).
# METRICS_PORT=9100

# Optional local inputs. Never downloaded.
# CVE_FEED=data/sample_cves.json
# ATTACK_STIX=data/enterprise-attack.json

# LangSmith tracing (optional; model.py is @traceable)
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=stride-lite
